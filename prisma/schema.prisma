datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── Usuário ───────────────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  discordId     String?   @unique
  steamId       String?   @unique
  name          String
  email         String?   @unique
  emailVerified DateTime?
  avatarUrl     String?
  passwordHash  String?

  // Steam OpenID (login via Steam / conta Steam vinculada)
  // SteamID64 armazenado como string (nunca number) para evitar perda de precisão.
  // steamId é único (constraint no banco): um SteamID pertence a no máximo 1 usuário.
  steamName       String?
  steamAvatarUrl  String?
  steamProfileUrl String?
  steamLinkedAt   DateTime? // quando o usuário vinculou a conta Steam ao perfil
  lastLibrarySyncAt DateTime? // última sincronização da biblioteca Steam (GetOwnedGames)
  lastLoginAt     DateTime?

  memberships    GroupMember[]
  gamesAdded     Game[]
  accounts       Account[]
  sessions       Session[]
  steamOwnedGames SteamOwnedGame[]

  createdAt DateTime @default(now())
}

// ─── Biblioteca Steam (GetOwnedGames) ─────────────────────────────────────
// Jogos que o usuário possui na Steam, persistidos após sincronização.
// Base para a tag "Já Possuo" no Kanban e para Estatísticas/Recomendações
// futuras (playtimeForever já é armazenado por isso — a API devolve grátis).
model SteamOwnedGame {
  id              String    @id @default(cuid())
  userId          String
  steamAppId      String
  // Minutos totais jogados (Steam) — reservado para Estatísticas futuras
  playtimeForever Int       @default(0)
  lastPlayedAt    DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Um jogo não pode ser possuído 2x pelo mesmo usuário (anti-duplicação)
  @@unique([userId, steamAppId])
  // Lookup rápido: todos os jogos de um usuário
  @@index([userId])
}

// ─── Grupos ────────────────────────────────────────────────────────────────
model Group {
  id         String       @id @default(cuid())
  name       String
  inviteCode String       @unique
  members    GroupMember[]
  games      Game[]
  createdAt  DateTime      @default(now())
}

model GroupMember {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  role      String   @default("MEMBER") // OWNER | MEMBER
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
}

// ─── Jogos ─────────────────────────────────────────────────────────────────
model Game {
  id              String   @id @default(cuid())
  groupId         String
  addedById       String
  steamAppId      String
  title           String
  imageUrl        String
  releaseDate     DateTime?
  isReleased      Boolean  @default(false)

  // Preços em centavos (BRL)
  originalPrice   Int?
  currentPrice    Int?
  discountPercent Int      @default(0)

  status          String   @default("BACKLOG") // BACKLOG | PLAYING | COMPLETED
  position        Int      @default(0)

  // Reviews (buscado da Steam)
  reviewScore     Int?     // Percentual positivo (ex: 94)
  reviewSummary   String?  // Texto resumido (ex: "Overwhelmingly Positive")

  // Jogadores simultâneos
  currentPlayers  Int?     // Jogando agora
  peak24h         Int?     // Pico nas últimas 24h

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedBy   User  @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, steamAppId])
}

// ─── NextAuth (Auth.js) ────────────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
